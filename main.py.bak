"""
main.py : orchestre le pipeline ML (Adult Census Income) via arguments CLI.

Exemples :
    python main.py --action train
    python main.py --action evaluate
    python main.py --action predict
"""

import argparse

from model_pipeline import (
    evaluate_model,
    load_model,
    prepare_data,
    save_model,
    train_model,
)


def main():
    parser = argparse.ArgumentParser(
        description="Pipeline de Machine Learning - Adult Census Income"
    )
    parser.add_argument(
        "--action",
        choices=["train", "evaluate", "predict"],
        required=True,
        help="train : entraîne, évalue et sauvegarde | "
             "evaluate : évalue le modèle sauvegardé | "
             "predict : prédit sur quelques exemples du jeu de test",
    )
    parser.add_argument("--data", default="adult.data",
                        help="Chemin vers le fichier de données")
    parser.add_argument("--model", default="random_forest_model.joblib",
                        help="Chemin du modèle sauvegardé")
    parser.add_argument("--preprocessor", default="preprocessor.joblib",
                        help="Chemin du préprocesseur sauvegardé")
    parser.add_argument("--n", type=int, default=5,
                        help="Nombre d'exemples pour --action predict")
    args = parser.parse_args()

    # Préparation (déterministe : random_state=42 dans prepare_data)
    X_train, X_test, y_train, y_test, preprocessor = prepare_data(args.data)

    if args.action == "train":
        model = train_model(X_train, y_train)

        print("\n===== Évaluation =====")
        for name, value in evaluate_model(model, X_test, y_test).items():
            print(f"{name}: {value:.4f}" if isinstance(value, float) else f"{name}: {value}")

        save_model(model, args.model)
        save_model(preprocessor, args.preprocessor)
        print(f"\nModèle sauvegardé : {args.model}")
        print("Pipeline terminé avec succès !")

    elif args.action == "evaluate":
        model = load_model(args.model)
        for name, value in evaluate_model(model, X_test, y_test).items():
            print(f"{name}: {value:.4f}" if isinstance(value, float) else f"{name}: {value}")

    elif args.action == "predict":
        model = load_model(args.model)
        sample = X_test.head(args.n)
        preds = model.predict(sample)
        probas = model.predict_proba(sample)[:, 1]
        labels = {0: "<=50K", 1: ">50K"}
        for i, (p, pr, real) in enumerate(zip(preds, probas, y_test.head(args.n))):
            print(f"Exemple {i + 1}: prédit {labels[p]} (proba >50K = {pr:.2f}) | réel {labels[real]}")


if __name__ == "__main__":
    main()
